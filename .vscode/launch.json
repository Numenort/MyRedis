{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Master Server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": ["--port", "6399"],  // 可选：传参指定端口
            "env": {
                "ROLE": "master"
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}